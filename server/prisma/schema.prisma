generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  ASSESSMENT
  OFFER
  REJECTED
  ARCHIVED
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum MissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ---------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  roles UserRole[]

  resumes         Resume[]
  roadmaps        Roadmap[]
  applications    Application[]
  sessions        Session[]
  profile         UserProfile?
  careerProfile   CareerProfile?
  files           FileRecord[]
  recommendations JobRecommendation[]

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// CORE DOMAINS
// ---------------------------------------------------------

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  headline  String?
  bio       String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  // Storing everything in JSON for simplicity
  education   Json? // [{ school, degree, field, startDate, endDate, score }]
  experience  Json? // [{ company, title, startDate, endDate, description }]
  skills      Json? // [{ name, proficiency }]
  projects    Json? // [{ name, url, description }]
  preferences Json? // { desiredRoles: [], locations: [], expectedSalary }

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id        String       @id @default(uuid())
  userId    String
  fileUrl   String
  fileName  String
  isPrimary Boolean      @default(false)
  status    ResumeStatus @default(UPLOADED)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  publicId      String?
  secureUrl     String?
  extractedText String?

  // Links to parsed data
  analysis ResumeAnalysis?
  matches  ResumeMatch[]
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id       String @id @default(uuid())
  resumeId String @unique

  atsScore      Int?
  summary       String?
  strengths     String[]
  weaknesses    String[]
  missingSkills String[]
  suggestions   String[]

  parsedData Json? // structured JSON from Gemini

  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model FileRecord {
  id        String   @id @default(uuid())
  userId    String
  fileName  String
  fileSize  Int
  mimeType  String
  s3Key     String
  s3Url     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// COMPANY & OPPORTUNITY
// ---------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  website     String?
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  opportunities Opportunity[]
}

model Opportunity {
  id               String   @id @default(uuid())
  companyId        String
  title            String
  type             String // FULL_TIME, INTERNSHIP
  status           String   @default("OPEN")
  description      String
  location         String?
  skillsRequired   String[]
  eligibilityRules Json?
  createdAt        DateTime @default(now())

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications    Application[]
  recommendations JobRecommendation[]
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(SAVED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// ROADMAP
// ---------------------------------------------------------

model Roadmap {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  targetRole  String
  isActive    Boolean  @default(true)
  progress    Float    @default(0.0)
  createdAt   DateTime @default(now())

  missions Mission[]
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mission {
  id          String        @id @default(uuid())
  roadmapId   String
  title       String
  description String?
  order       Int
  status      MissionStatus @default(PENDING)
  progress    Float         @default(0.0)

  milestones Milestone[]
  roadmap    Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String  @id @default(uuid())
  missionId   String
  title       String
  order       Int
  isCompleted Boolean @default(false)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// RECOMMENDATIONS
// ---------------------------------------------------------

model JobRecommendation {
  id             String   @id @default(uuid())
  userId         String
  opportunityId  String
  overallScore   Float
  scoreBreakdown Json // skillMatch, experienceMatch, educationMatch
  missingSkills  String[]
  rationale      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}
model ResumeMatch {
  id             String   @id @default(uuid())
  resumeId       String
  jobDescription String
  matchScore     Int
  feedback       Json
  createdAt      DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}
